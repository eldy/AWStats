msgstr "Dagsetning - Fjöldi síðna - Fjöldi beiðna - Bandbreidd - Heimsóknir"

msgid "Domain - Pages - Hits - Bandwidth"
msgstr "Lén - Fjöldi síðna - Fjöldi beiðna - Bandbreidd"

