msgstr "Óþekkt tilvísunarstýrikerfi - Dagsetning síðustu heimsóknar"

msgid "Screen size - Hits"
msgstr "Skjáupplausn - Fjöldi beiðna"

msgid "Browser ID - Hits - Pages"
msgstr "Kenni vafra - Fjöldi smella - Fjöldi síðna"

msgid "Downloads - Hits - Bandwidth"
msgstr "Niðurhöl - Fjöldi beiðna - Bandbreidd"

msgid "Protocol - Hits - Bandwidth"
msgstr "Samskiptaregla - Fjöldi beiðna - Bandbreidd"

