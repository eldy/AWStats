msgstr "TotalVisits = Fjöldi heimsókna"

msgid "TotalUnique = Number of unique visitors"
msgstr "TotalUnique = Fjöldi einstakra gesta"

msgid "MonthHostsKnown   = Number of hosts known"
msgstr "MonthHostsKnown   = Fjöldi þekktra hýsla"

msgid "MonthHostsUnKnown = Number of hosts unknown"
msgstr "MonthHostsUnKnown = Fjöldi óþekktra hýsla"

