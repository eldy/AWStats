msgstr "Þyrpingarkenni - Fjöldi síðna - Fjöldi beiðna - Bandbreidd"

msgid "Hour - Pages - Hits - Bandwidth - Not viewed Pages - Not viewed Hits - Not viewed Bandwidth"
msgstr "Klukkustund - Fjöldi síðna - Fjöldi beiðna - Bandbreidd - Óskoðaðar síður - Óskoðaðar beiðnir - Óskoðuð bandbreidd"

