msgstr "an rannóg MAP a bhaint go hiomlán freisin (scríobhfaidh AWStats arís é ar an gcéad nuashonrú eile)"

msgid "LastLine    = Date of last record processed - Last record line number in last log - Last record offset in last log - Last record signature value"
