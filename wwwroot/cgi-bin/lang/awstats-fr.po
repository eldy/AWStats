"    <ul>"
"      <li>Précision de la détection des robots d'indexation</li>"
"      <li>La détection complète ralentit le traitement d'environ 2-5 % (selon le volume de logs)</li>"
"    </ul>"
"    <div class='config-default'>Défaut: 2</div>"
"  </div>"
"</div>"
""
"<!-- LevelForSearchEnginesDetection -->"
