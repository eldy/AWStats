msgid "Robot ID - Hits - Bandwidth - Last visit - Hits on robots.txt"
msgstr "ID robota - Broj pogodaka - Propusnost - Vrijeme posljednjeg posjeta - Pogodci na robots.txt"

msgid "Worm ID - Hits - Bandwidth - Last visit"
msgstr "ID crva - Broj pogodaka - Propusnost - Vrijeme posljednjeg posjeta"

msgid "EMail - Hits - Bandwidth - Last visit"
msgstr "E-pošta - Broj pogodaka - Propusnost - Vrijeme posljednjeg posjeta"

msgid "The first %s email addresses are sorted by hits in descending order; order of the remaining addresses is undefined."
msgstr "Prvih %s adresa e-pošte je sortirano prema broju pogodaka u silaznom redoslijedu; redoslijed preostalih adresa nije definiran."

msgid "URL - Pages - Bandwidth - Entry - Exit"
msgstr "URL - Broj stranica - Propusnost - Ulaz - Izlaz"

