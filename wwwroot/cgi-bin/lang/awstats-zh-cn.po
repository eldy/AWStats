"                    <td>1-10秒</td>"
"                </tr>"
"                <tr>"
"                    <td>1,000 - 10,000</td>"
"                    <td>任意</td>"
"                    <td>1</td>"
"                    <td>0</td>"
"                    <td>0</td>"
"                    <td>每日一次<br><small>日志文件 1-10 MB<br>2000-20000 行</small></td>"
"                    <td>4 MB</td>"
"                    <td>2-10分钟</td>"
"                </tr>"
"                <tr>"
"                    <td>10,000 - 100,000</td>"
"                    <td>任意</td>"
"                    <td>0（或2）</td>"
"                    <td>0</td>"
"                    <td>0</td>"
"                    <td>每日一次<br><small>日志文件 10-100 MB<br>20000-200000 行</small></td>"
"                    <td>4 MB</td>"
