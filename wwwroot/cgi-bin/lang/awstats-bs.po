msgid "AWStats %s - Advanced Web Statistics"
msgstr "AWStats %s - napredna web statistika"

msgid "Copyright (c) 2000-2025 Laurent Destailleur"
msgstr "Autorska prava (c) 2000-2025 Laurent Destailleur"

