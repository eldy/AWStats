"  <tr><td>917</td><td>917 Sendmail: Alias database error</td></tr>"
"  <tr><td>918</td><td>918 Sendmail: Virtuser table error</td></tr>"
"  <tr><td>919</td><td>919 Sendmail: Mailer definition error</td></tr>"
"  <tr><td>920</td><td>920 Exim: Router configuration error</td></tr>"
"  <tr><td>921</td><td>921 Exim: Transport configuration error</td></tr>"
"  <tr><td>922</td><td>922 Exim: Director configuration error</td></tr>"
"  <tr><td>923</td><td>923 Exim: Retry configuration error</td></tr>"
"  <tr><td>924</td><td>924 Exim: Rewrite configuration error</td></tr>"
"  <tr><td>925</td><td>925 Exim: Authentication configuration error</td></tr>"
