"  <tr><td>901</td><td>901 Exchange: Store driver error</td></tr>"
"  <tr><td>902</td><td>902 Exchange: Transport agent error</td></tr>"
"  <tr><td>903</td><td>903 Exchange: Content conversion error</td></tr>"
"  <tr><td>904</td><td>904 Exchange: Routing error</td></tr>"
"  <tr><td>905</td><td>905 Exchange: Mail flow stalled</td></tr>"
"  <tr><td>906</td><td>906 Exchange: Shadow redundancy error</td></tr>"
"  <tr><td>907</td><td>907 Exchange: Safety net error</td></tr>"
"  <tr><td>908</td><td>908 Exchange: Queue database error</td></tr>"
"  <tr><td>909</td><td>909 Exchange: Message throttled</td></tr>"
"  <tr><td>910</td><td>910 Postfix: Bounce queue error</td></tr>"
