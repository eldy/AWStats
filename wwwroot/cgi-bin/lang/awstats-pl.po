msgstr "ID robaka - Trafienia - Przepustowość - Ostatnia wizyta"

msgid "EMail - Hits - Bandwidth - Last visit"
msgstr "E-mail - Trafienia - Przepustowość - Ostatnia wizyta"

msgid "The first %s email addresses are sorted by hits in descending order; order of the remaining addresses is undefined."
msgstr "Pierwszych %s adresów e-mail jest posortowanych według liczby trafień w kolejności malejącej; kolejność pozostałych adresów jest nieokreślona."

