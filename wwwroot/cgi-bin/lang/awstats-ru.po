msgstr "Диапазон времени запроса - Частота времени запроса"

msgid "Payload Range - Payload Frequency"
msgstr "Диапазон размера - Частота размера"

msgid "Session range - Number of visits"
msgstr "Диапазон сеанса - Количество визитов"

msgid "URL with %s errors - Hits"
msgstr "URL с ошибками %s - Хитов"

msgid "Last URL referrer"
msgstr "Последний URL-источник"

msgid "Errors - Hits - Bandwidth"
msgstr "Ошибки - Хитов - Трафика"

