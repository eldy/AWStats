msgstr "ID робота - Хитов - Трафика - Последний визит - Хитов на robots.txt"

msgid "Worm ID - Hits - Bandwidth - Last visit"
msgstr "ID червя - Хитов - Трафика - Последний визит"

msgid "EMail - Hits - Bandwidth - Last visit"
msgstr "Электронная почта - Хитов - Трафика - Последний визит"

msgid "The first %s email addresses are sorted by hits in descending order; order of the remaining addresses is undefined."
msgstr "Первые %s адресов электронной почты отсортированы по количеству хитов в порядке убывания; порядок остальных адресов не определён."

msgid "URL - Pages - Bandwidth - Entry - Exit"
msgstr "URL - Страниц - Трафика - Вход - Выход"

