msgid "Unknown referer OS - Last visit date"
msgstr "Неизвестная ОС источника - Дата последнего посещения"

msgid "Screen size - Hits"
msgstr "Размер экрана - Хитов"

msgid "Browser ID - Hits - Pages"
msgstr "ID браузера - Хитов - Страниц"

msgid "Downloads - Hits - Bandwidth"
msgstr "Загрузки - Хитов - Трафика"

msgid "Protocol - Hits - Bandwidth"
msgstr "Протокол - Хитов - Трафика"

