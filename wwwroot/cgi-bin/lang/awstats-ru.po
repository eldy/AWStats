msgstr "8.0"

msgid "changelog.8.0.items"
msgstr ""
"<li>👋 <em>Это последняя версия, поддерживаемая разработчиком (Laurent Destailleur)</em></li>"
"<li>🔄 Улучшение таблиц стилей CSS</li>"
"<li>📋 Обновление базы данных robots.pm</li>"
