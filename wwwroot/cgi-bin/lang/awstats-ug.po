msgid "Screen size - Hits"
msgstr "ئېكران چوڭلۇقى - ھىتلەر"

msgid "Browser ID - Hits - Pages"
msgstr "كۆرۈش پروگراممىسى كىمىلىكى - ھىتلەر - بەتلەر"

msgid "Downloads - Hits - Bandwidth"
msgstr "چۈشۈرۈشلەر - ھىتلەر - سىمسىز يول كەڭلىكى"

msgid "Protocol - Hits - Bandwidth"
