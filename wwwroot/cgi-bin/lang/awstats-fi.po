msgstr "  -showunknownorigin   tulostaa viittauksen, kun sitä ei voida jäsentää"

msgid "  -showdirectorigin   to output log line when origin is a direct access"
msgstr "  -showdirectorigin    tulostaa lokirivin, kun alkuperä on suora käyttö"

