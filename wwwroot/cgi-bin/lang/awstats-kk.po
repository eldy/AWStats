msgstr "Экран өлшемі - Соққылар"

msgid "Browser ID - Hits - Pages"
msgstr "Браузер ID - Соққылар - Беттер"

msgid "Downloads - Hits - Bandwidth"
msgstr "Жүктеулер - Соққылар - Өткізу қабілеттілігі"

