msgid "period_21"
msgstr "Jam 21 · Larut malam, pengamat data diam-diam +1"

msgid "period_22"
msgstr "Jam 22 · Data hari ini akan segera siap, tegang?"

msgid "period_23"
msgstr "Jam 23 · AWStats: Waktunya tidur, besok kerja lagi"

