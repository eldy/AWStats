msgstr "Išorinių puslapių šaltiniai - Puslapių skaičius - Užklausų skaičius"

msgid "Only top %s external referrers shown on main page (sorted by pages). See full list on detail page."
msgstr "Pagrindiniame puslapyje rodomi tik pirmi %s išoriniai šaltiniai (rūšiuojami pagal puslapių skaičių). Išsamų sąrašą rasite išsamiame puslapyje."

msgid "Search engine referers ID - Pages - Hits"
msgstr "Paieškos variklio šaltinio ID - Puslapių skaičius - Užklausų skaičius"

msgid "Origin - Pages - Hits"
msgstr "Kilmė - Puslapių skaičius - Užklausų skaičius"

msgid "Unknown referer Browser - Last visit date"
msgstr "Nežinoma šaltinio naršyklė - Paskutinio apsilankymo data"

msgid "Unknown referer OS - Last visit date"
msgstr "Nežinoma šaltinio OS - Paskutinio apsilankymo data"

msgid "Screen size - Hits"
msgstr "Ekrano raiška - Užklausų skaičius"

msgid "Browser ID - Hits - Pages"
msgstr "Naršyklės ID - Paspaudimų skaičius - Puslapių skaičius"

msgid "Downloads - Hits - Bandwidth"
msgstr "Atsisiuntimai - Užklausų skaičius - Pralaidumas"

