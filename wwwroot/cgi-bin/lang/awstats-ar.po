"ShowHoursStats=HB\n"
"ShowDomainsStats=0\n"
"ShowHostsStats=HBL\n"
"ShowAuthenticatedUsers=0\n"
"ShowRobotsStats=0\n"
"ShowEMailSenders=HBML\n"
"ShowEMailReceivers=HBML\n"
"ShowSessionsStats=0\n"
"ShowPagesStats=0\n"
"ShowFileTypesStats=0\n"
"ShowFileSizesStats=0\n"
