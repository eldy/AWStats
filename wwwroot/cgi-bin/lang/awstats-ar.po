msgid "devgraphs.types.title"
msgstr "📈 أنواع الرسوم البيانية والبيانات"

msgid "devgraphs.types.desc"
msgstr "فيما يلي أنواع الرسوم البيانية المختلفة وترتيب ظهور البيانات في المصفوفات المرتبطة بها:"

msgid "devgraphs.types.list"
msgstr ""
"<ul class='type-list'>"
"  <li><strong>month</strong> - رسم بياني لكل شهر في سنة معينة"
"  <ul>"
"    <li>الزوار الفريدون</li>"
"    <li>عدد الزيارات</li>"
"    <li>عدد الصفحات</li>"
"    <li>عدد الطلبات</li>"
"    <li>عرض النطاق</li>"
"  </ul></li>"
"  <li><strong>daysofmonth</strong> - رسم بياني لكل يوم في الشهر"
"  <ul>"
"    <li>عدد الزيارات</li>"
"    <li>عدد الصفحات</li>"
"    <li>عدد الطلبات</li>"
"    <li>عرض النطاق</li>"
"  </ul></li>"
"  <li><strong>daysofweek</strong> - متوسط مجموعة البيانات لكل يوم في الأسبوع"
"  <ul>"
"    <li>عدد الصفحات</li>"
"    <li>عدد الطلبات</li>"
"    <li>عرض النطاق</li>"
"  </ul></li>"
"  <li><strong>hours</strong> - متوسط مجموعة البيانات لكل ساعة في اليوم"
"  <ul>"
"    <li>عدد الصفحات</li>"
"    <li>عدد الطلبات</li>"
"    <li>عرض النطاق</li>"
"  </ul></li>"
"  <li><strong>cluster</strong> - أهم 5 خوادم عنقودية عند تمكين خيار العنقود"
"  <ul>"
"    <li>عدد الصفحات</li>"
"  </ul></li>"
"  <li><strong>filetypes</strong> - أهم 5 أنواع ملفات في التقرير"
"  <ul>"
"    <li>عدد الصفحات</li>"
"  </ul></li>"
"  <li><strong>httpstatus</strong> - أهم 5 رموز حالة HTTP"
"  <ul>"
"    <li>عدد الصفحات</li>"
"  </ul></li>"
"  <li><strong>browsers</strong> - أهم 5 متصفحات"
"  <ul>"
"    <li>عدد الصفحات</li>"
"  </ul></li>"
"  <li><strong>oss</strong> - أهم 5 أنظمة تشغيل"
"  <ul>"
"    <li>عدد الصفحات</li>"
"  </ul></li>"
"  <li><strong>hosts</strong> - أهم 5 مضيفات"
"  <ul>"
"    <li>عدد الصفحات</li>"
"  </ul></li>"
"  <li><strong>countries_map</strong> - قائمة بجميع الدول وعدد طلباتها"
"  <ul>"
"    <li>عدد الطلبات</li>"
"  </ul></li>"
"</ul>"

