msgstr "  %s محرك بحث (وعبارات البحث/الكلمات المفتاحية المستخدمة منها)"

msgid "  All HTTP errors with last referrer"
msgstr "  جميع أخطاء HTTP مع آخر مرسل"

msgid "  Report by day/month/year"
msgstr "  تقرير حسب اليوم/الشهر/السنة"

msgid "  Dynamic or static HTML or XHTML reports, static PDF reports"
msgstr "  تقارير HTML أو XHTML ديناميكية أو ثابتة، تقارير PDF ثابتة"

