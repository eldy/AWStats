msgstr "%s त्रुटियों वाला URL - अनुरोधों की संख्या"

msgid "Last URL referrer"
msgstr "अंतिम URL रेफ़रर"

msgid "Errors - Hits - Bandwidth"
msgstr "त्रुटियाँ - अनुरोधों की संख्या - बैंडविड्थ"

msgid "Search keywords - Number of search"
msgstr "कीवर्ड - खोजों की संख्या"

msgid "Only top %s keywords shown on main page (sorted by search count). See full list on detail page."
msgstr "मुख्य पृष्ठ केवल %s शीर्ष कीवर्ड दिखाता है (खोज संख्या के अनुसार क्रमबद्ध)। कृपया विवरण पृष्ठ पर पूरी सूची देखें"

