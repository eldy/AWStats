msgid "Search engine referers ID - Pages - Hits"
msgstr "खोज इंजन रेफ़रर ID - पृष्ठों की संख्या - अनुरोधों की संख्या"

msgid "Origin - Pages - Hits"
msgstr "स्रोत - पृष्ठों की संख्या - अनुरोधों की संख्या"

