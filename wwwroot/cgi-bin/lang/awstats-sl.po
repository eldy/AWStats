msgstr "Število različnih obiskovalcev, ki so obiskali vašo spletno stran v izbranem časovnem obdobju. Statistika temelji na IP naslovu."

msgid "tooltip_3"
msgstr "Število zahtev, ki se štejejo za strani (kot so HTML, PHP, ASP itd.), razen statičnih datotek, kot so slike, CSS, JS."

