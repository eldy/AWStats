msgstr "MonthHostsKnown   = 既知のホスト数"

msgid "MonthHostsUnKnown = Number of hosts unknown"
msgstr "MonthHostsUnKnown = 未知のホスト数"

msgid "Cluster ID - Pages - Hits - Bandwidth"
msgstr "クラスターID - ページ数 - ヒット数 - 帯域幅"

