"  </div>"
"  <div class='link-card'>"
"    <div class='link-icon'>🛒</div>"
"    <div class='link-title'>doliStore</div>"
"    <div class='link-url'><a href='https://www.dolistore.com' target='_blank' rel='noopener'>https://www.dolistore.com</a></div>"
"    <div>AWStats Dolibarr モジュールをダウンロードするマーケットプレイス</div>"
