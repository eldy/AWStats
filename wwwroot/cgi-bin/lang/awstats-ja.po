msgstr "不明なリファラーOS - 最終アクセス日時"

msgid "Screen size - Hits"
msgstr "画面解像度 - ヒット数"

msgid "Browser ID - Hits - Pages"
msgstr "ブラウザID - ヒット数 - ページ数"

msgid "Downloads - Hits - Bandwidth"
msgstr "ダウンロード - ヒット数 - 帯域幅"

