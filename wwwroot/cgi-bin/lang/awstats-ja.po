msgstr "FirstTime   = 履歴ファイルの最初のアクセス日"

msgid "LastTime    = Date of last visit for history file"
msgstr "LastTime    = 履歴ファイルの最後のアクセス日"

msgid "LastUpdate  = Date of last update - Nb of parsed records - Nb of parsed old records - Nb of parsed new records - Nb of parsed corrupted - Nb of parsed dropped"
msgstr "LastUpdate  = 最終更新日 - 解析レコード数 - 旧レコード数 - 新レコード数 - 破損レコード数 - 破棄レコード数"

