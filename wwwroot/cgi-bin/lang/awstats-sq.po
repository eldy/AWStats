msgstr "Ora 17 · Orari i punës ka përfunduar! Por serveri ende po punon"

msgid "period_18"
msgstr "Ora 18 · Koha e darkës"

msgid "period_19"
msgstr "Ora 19 · Koha e artë, trafiku i pikut"

msgid "period_20"
msgstr "Ora 20 · I shtrirë në divan, ju jeni vizitori numër 114514"

msgid "period_21"
msgstr "Ora 21 · Nata po thellohet, bufat që shikojnë fshehurazi të dhënat +1"

