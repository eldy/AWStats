msgstr "ਅਣਜਾਣ ਬਰਾਊਜ਼ਰ (ਸੂਚੀ)"

msgid "Unknown Screen"
msgstr "ਅਣਜਾਣ ਸਕ੍ਰੀਨ ਅਕਾਰ"

msgid "Login"
msgstr "ਉਪਭੋਗੀ"

msgid "Anonymous"
msgstr "ਅਗਿਆਤ"

msgid "Robots"
msgstr "ਰੋਬੋਟ"

msgid "Different robots"
msgstr "ਵੱਖ-ਵੱਖ ਰੋਬੋਟ"

msgid "Hits on robots.txt"
msgstr "ਉੱਪਰ ਸੂਚੀਬੱਧ ਖੋਜ ਇੰਜਣ ਰੋਬੋਟਾਂ ਦੁਆਰਾ ਪੈਦਾ ਕੀਤਾ "ਅਸਧਾਰਨ" ਟ੍ਰੈਫਿਕ ਹੋਰ ਚਾਰਟ ਵਿੱਚ ਸ਼ਾਮਲ ਨਹੀਂ ਕੀਤਾ ਗਿਆ ਹੈ। "+" ਤੋਂ ਬਾਅਦ ਦੀ ਸੰਖਿਆ "robots.txt" ਤੱਕ ਸਫਲ ਪਹੁੰਚਾਂ ਦੀ ਗਿਣਤੀ ਨੂੰ ਦਰਸਾਉਂਦੀ ਹੈ"

msgid "Worms"
msgstr "ਕੀੜੇ"

