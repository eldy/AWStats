msgid "Domain - Pages - Hits - Bandwidth"
msgstr "ਡੋਮੇਨ - ਸਫ਼ੇ - ਹਿੱਟਸ - ਬੈਂਡਵਿਡਥ"

msgid "The %s first Pages must be first (order not required for others)"
msgstr "ਮੁੱਖ ਸਫ਼ੇ 'ਤੇ ਸਿਰਫ਼ ਪਹਿਲੇ %s ਸਭ ਤੋਂ ਵੱਧ ਦੇਖੇ ਗਏ ਸਫ਼ੇ ਦਿਖਾਏ ਗਏ ਹਨ, ਪੂਰੀ ਸੂਚੀ ਲਈ ਵੇਰਵਾ ਸਫ਼ਾ ਦੇਖੋ"

msgid "Host - Pages - Hits - Bandwidth - Last visit date - [Start date of last visit] - [Last page of last visit]"
msgstr "ਹੋਸਟ - ਸਫ਼ੇ - ਹਿੱਟਸ - ਬੈਂਡਵਿਡਥ - ਆਖਰੀ ਵਿਜ਼ਿਟ ਦੀ ਮਿਤੀ - [ਆਖਰੀ ਵਿਜ਼ਿਟ ਦੀ ਸ਼ੁਰੂਆਤੀ ਮਿਤੀ] - [ਆਖਰੀ ਵਿਜ਼ਿਟ ਦਾ ਆਖਰੀ ਸਫ਼ਾ]"

msgid "[Start date of last visit] and [Last page of last visit] are saved only if session is not finished"
msgstr "[ਆਖਰੀ ਵਿਜ਼ਿਟ ਦੀ ਸ਼ੁਰੂਆਤੀ ਮਿਤੀ] ਅਤੇ [ਆਖਰੀ ਵਿਜ਼ਿਟ ਦਾ ਆਖਰੀ ਸਫ਼ਾ] ਸਿਰਫ ਉਦੋਂ ਸੁਰੱਖਿਅਤ ਕੀਤੇ ਜਾਂਦੇ ਹਨ ਜੇਕਰ ਸੈਸ਼ਨ ਖਤਮ ਨਹੀਂ ਹੋਇਆ ਹੈ"

