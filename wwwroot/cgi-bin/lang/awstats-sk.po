msgstr "17:00 · Práca skončila! Ale server stále pracuje"

msgid "period_18"
msgstr "18:00 · Čas večere"

msgid "period_19"
msgstr "19:00 · Hlavný vysielací čas, špičková návštevnosť"

msgid "period_20"
msgstr "20:00 · Povaľujete sa na gauči, ste 114514. návštevník"

msgid "period_21"
msgstr "21:00 · Noc sa prehlbuje, nočná sova, ktorá tajne pozerá údaje +1"

