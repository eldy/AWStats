msgstr "MonthHostsKnown   = Teadaolevate hostide arv"

msgid "MonthHostsUnKnown = Number of hosts unknown"
msgstr "MonthHostsUnKnown = Tundmatute hostide arv"

msgid "Cluster ID - Pages - Hits - Bandwidth"
msgstr "Klastri ID - Lehtede arv - Päringute arv - Lairiba"

msgid "Hour - Pages - Hits - Bandwidth - Not viewed Pages - Not viewed Hits - Not viewed Bandwidth"
msgstr "Tund - Lehtede arv - Päringute arv - Lairiba - Vaatamata lehed - Vaatamata päringud - Vaatamata lairiba"

