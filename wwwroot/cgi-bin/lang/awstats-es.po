msgstr "6 p.m. · Hora de cenar, mira un vídeo para relajarte"

msgid "period_19"
msgstr "7 p.m. · Horario de máxima audiencia, pico de tráfico, servidor: Aguanto"

msgid "period_20"
msgstr "8 p.m. · Repantigado en el sofá, eres el visitante número 114514"

msgid "period_21"
msgstr "9 p.m. · Por la noche, los que miran datos a escondidas +1"

msgid "period_22"
msgstr "10 p.m. · Los datos de hoy estarán listos pronto, nervioso?"

msgid "period_23"
msgstr "11 p.m. · AWStats: Hora de dormir, mañana hay que trabajar"

