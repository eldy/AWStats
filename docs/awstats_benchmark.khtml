                            <td class="param-cell" data-i18n="param0or1">0 或 1</td>
                            <td data-i18n="freq1">每天一次<br>日志文件 0-1 MB<br>处理 2000 行</td>
                            <td class="param-cell">4 MB 空闲</td>
