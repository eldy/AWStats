            <div class="attribution" data-i18n="darkAttr">
                🌓 自适应暗黑 · 现代化重构
            </div>
        </div>
    </footer>

    <script>
        (function() {
            document.getElementById('currentYear').textContent = new Date().getFullYear();

            // 完整翻译资源
            const translations = {
                zh: {
                    // 导航
                    home: "主页",
                    currentPage: "基准测试",
                    categoryBasic: "📌 基础文档",
                    categoryGuide: "📘 使用指南",
                    categoryReference: "📚 参考资源",
                    categoryIntegration: "🧩 集成与扩展",
                    categoryDev: "💻 开发者文档",
                    
                    navHome: "主页",
                    navWhat: "什么是AWStats",
                    navSetup: "安装配置",
                    navWebmin: "Webmin模块",
                    navUpgrade: "升级指南",
                    navTools: "其他工具",
                    navSecurity: "安全建议",
                    navLicense: "许可证",
                    navGlossary: "术语表",
                    navFAQ: "FAQ",
                    navExtra: "额外部分",
                    navDolibarr: "Dolibarr模块",
                    navPlugins: "插件开发",
                    navHooks: "插件钩子",
                    navGraphs: "插件图形",
