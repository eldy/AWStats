<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AWStats · 基准测试</title>
    <meta name="description" content="AWStats Documentation - Benchmark page (中文/English)">
    <meta name="keywords" content="awstats, benchmark, speed, dns, performance, 基准测试">
    <meta name="author" content="Laurent Destailleur (多语言重构)">
    <meta name="robots" content="index,follow">
<style>
/* ========== 现代化全局设计 ========== */
* { 
    margin: 0; 
    padding: 0; 
    box-sizing: border-box; 
}

/* ===== 主题变量 ===== */
:root {
    --bg-page: #f8fafc; 
    --surface: #ffffff; 
    --surface-secondary: #f1f5f9;
    --text-primary: #0f172a; 
    --text-secondary: #475569; 
    --accent: #4f46e5;
    --accent-light: #818cf8; 
    --accent-soft: #eef2ff; 
    --border: #e2e8f0;
    --card-shadow: 0 20px 25px -5px rgba(0,0,0,0.05), 0 10px 10px -5px rgba(0,0,0,0.02);
    --header-bg: linear-gradient(135deg, #4f46e5 0%, #4f46e5 100%);
    --footer-bg: #eef2ff; 
    --link-color: #4f46e5; 
    --link-visited: #4f46e5; /* 统一为 link-color，移除紫色 */
    --code-bg: #f1f5f9; 
    --success: #10b981; 
    --warning: #f59e0b; 
    --danger: #ef4444;
    --star-color: #fbbf24;
}

/* 深色模式 */
@media (prefers-color-scheme: dark) {
    :root {
        --bg-page: #0f172a; 
        --surface: #1e293b; 
        --surface-secondary: #334155;
        --text-primary: #f1f5f9; 
        --text-secondary: #cbd5e1; 
        --accent: #818cf8;
        --accent-light: #a5b4fc; 
        --accent-soft: #2d3a5e; 
        --border: #475569;
        --card-shadow: 0 20px 25px -5px rgba(0,0,0,0.5);
        --header-bg: linear-gradient(135deg, #4f46e5 0%, #4f46e5 100%);
        --footer-bg: #1e293b; 
        --link-color: #a5b4fc; 
        --link-visited: #a5b4fc; /* 统一为 link-color，移除紫色 */
        --code-bg: #334155; 
        --success: #34d399; 
        --warning: #fbbf24; 
        --danger: #f87171;
    }
}

/* 强制浅色模式 */
.force-light,
.force-light :root {
    --bg-page: #f8fafc; 
    --surface: #ffffff; 
    --surface-secondary: #f1f5f9;
    --text-primary: #0f172a; 
    --text-secondary: #475569; 
    --accent: #4f46e5;
    --accent-light: #818cf8; 
    --accent-soft: #eef2ff; 
    --border: #e2e8f0;
    --card-shadow: 0 20px 25px -5px rgba(0,0,0,0.05), 0 10px 10px -5px rgba(0,0,0,0.02);
    --header-bg: linear-gradient(135deg, #4f46e5 0%, #4f46e5 100%);
    --footer-bg: #eef2ff; 
    --link-color: #4f46e5; 
    --link-visited: #4f46e5; /* 统一颜色 */
    --code-bg: #f1f5f9; 
    --success: #10b981; 
    --warning: #f59e0b; 
    --danger: #ef4444;
}

/* 强制深色模式 */
.force-dark,
.force-dark :root {
    --bg-page: #0f172a; 
    --surface: #1e293b; 
    --surface-secondary: #334155;
    --text-primary: #f1f5f9; 
    --text-secondary: #cbd5e1; 
    --accent: #818cf8;
    --accent-light: #a5b4fc; 
    --accent-soft: #2d3a5e; 
    --border: #475569;
    --card-shadow: 0 20px 25px -5px rgba(0,0,0,0.5);
    --header-bg: linear-gradient(135deg, #4f46e5 0%, #4f46e5 100%);
    --footer-bg: #1e293b; 
    --link-color: #a5b4fc; 
    --link-visited: #a5b4fc; /* 统一颜色 */
    --code-bg: #334155; 
    --success: #34d399; 
    --warning: #fbbf24; 
    --danger: #f87171;
}

/* ===== 基础样式 ===== */
body {
    background-color: var(--bg-page); 
    color: var(--text-primary);
    font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    line-height: 1.6; 
    margin: 0; 
    padding: 0;
    transition: background-color 0.2s ease, color 0.2s ease;
    display: flex; 
    flex-direction: column; 
    min-height: 100vh;
}

.container { 
    max-width: 1300px; 
    margin: 0 auto; 
    padding: 0 28px; 
    width: 100%; 
}

/* ===== 链接全局样式 - 移除下划线和访问颜色变化 ===== */
a, a:link, a:visited {
    text-decoration: none;
    color: var(--link-color);
    transition: color 0.2s ease;
}

a:hover {
    color: var(--accent);
}

/* ===== 导航栏基础 ===== */
.nav-bar {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    padding: 12px 0;
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(12px);
    background-color: rgba(var(--surface-rgb), 0.8);
}

/* ===== 桌面端样式 (≥701px) ===== */
@media (min-width: 701px) {
    .nav-container {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 20px;
    }
    
    .nav-header {
        display: flex;
        align-items: center;
        gap: 20px;
        flex-shrink: 0;
    }
    
    .nav-left {
        display: flex;
        align-items: center;
        gap: 20px;
    }
    
    .nav-home {
        font-weight: 700;
        font-size: 1.3rem;
        background: linear-gradient(135deg, var(--accent), var(--accent-light));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        display: flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
    }
    
    .breadcrumb {
        display: flex;
        gap: 8px;
        align-items: center;
        color: var(--text-secondary);
        font-size: 0.9rem;
        white-space: nowrap;
    }
    
    .dropdown-menu {
        display: flex;
        align-items: center;
        gap: 4px;
        flex-wrap: nowrap;
        margin-top: 0;
    }
    
    .dropdown-item {
        position: relative;
        flex-shrink: 0;
    }
    
    .dropdown-title {
        padding: 6px 12px;
        background: var(--surface-secondary);
        border: 1px solid var(--border);
        border-radius: 30px;
        font-weight: 500;
        font-size: 0.95rem;
        color: var(--text-primary);
        cursor: pointer;
        transition: all 0.2s;
        white-space: nowrap;
        user-select: none;
    }
    
    .dropdown-title:hover {
        background: var(--accent-soft);
        color: var(--accent);
        border-color: var(--accent-light);
    }
    
    .dropdown-content {
        position: absolute;
        top: 100%;
        left: 0;
        min-width: 220px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 12px;
        box-shadow: var(--card-shadow);
        display: none;
        z-index: 1000;
        margin-top: 5px;
    }
    
    .mobile-menu-toggle {
        display: none;
    }
}

/* ===== 移动端样式 (≤700px) ===== */
@media (max-width: 700px) {
    .nav-container {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }
    
    .nav-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        gap: 10px;
    }
    
    .nav-left {
        display: flex;
        align-items: center;
        gap: 10px;
        flex: 1;
    }
    
    .nav-home {
        font-weight: 700;
        font-size: 1.1rem;
        background: linear-gradient(135deg, var(--accent), var(--accent-light));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        display: flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
    }
    
    .breadcrumb {
        display: flex;
        gap: 8px;
        align-items: center;
        color: var(--text-secondary);
        font-size: 0.8rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 150px;
    }
    
    /* 汉堡菜单按钮 */
    .mobile-menu-toggle {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        background: var(--surface-secondary);
        border: 1px solid var(--border);
        border-radius: 40px;
        color: var(--text-primary);
        font-size: 1.2rem;
        cursor: pointer;
        transition: all 0.2s;
        margin-left: auto;
    }
    
    .mobile-menu-toggle:hover {
        background: var(--accent-soft);
        color: var(--accent);
    }
    
    /* 导航菜单 - 默认隐藏 */
    .dropdown-menu {
        display: none;
        flex-direction: column;
        width: 100%;
        gap: 8px;
        margin-top: 5px;
    }
    
    /* 菜单展开时显示 */
    .dropdown-menu.mobile-active {
        display: flex;
    }
    
    .dropdown-item {
        width: 100%;
        position: relative;
    }
    
    .dropdown-title {
        width: 100%;
        padding: 12px 16px;
        background: var(--surface-secondary);
        border: 1px solid var(--border);
        border-radius: 40px;
        font-weight: 500;
        color: var(--text-primary);
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        justify-content: space-between;
        align-items: center;
        user-select: none;
        font-size: 0.95rem;
    }
    
    .dropdown-title:hover {
        background: var(--accent-soft);
        color: var(--accent);
    }
    
    .dropdown-title::after {
        content: "▼";
        font-size: 0.7rem;
        transition: transform 0.2s;
    }
    
    .dropdown-item.active .dropdown-title::after {
        transform: rotate(180deg);
    }
    
    .dropdown-content {
        position: static;
        width: 100%;
        margin-top: 5px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 8px;
        box-shadow: none;
        display: none;
    }
    
    .dropdown-content a {
        width: 100%;
        text-align: center;
        padding: 10px;
        color: var(--text-secondary);
        font-weight: 500;
        border-radius: 30px;
        transition: all 0.2s;
        font-size: 0.95rem;
        background: var(--surface-secondary);
        border: 1px solid var(--border);
        white-space: nowrap;
        margin: 2px 0;
    }
    
    .dropdown-content a:hover {
        background: var(--accent-soft);
        color: var(--accent);
    }
    
    .dropdown-content a.active {
        background: var(--accent);
        color: white;
        border-color: var(--accent);
    }
}

/* ===== 下拉菜单通用样式 ===== */
.dropdown-item.active .dropdown-content {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: auto;
    min-width: auto;
}

.dropdown-content a {
    color: var(--text-secondary);
    font-weight: 500;
    padding: 8px 12px;
    border-radius: 30px;
    transition: all 0.2s;
    font-size: 0.95rem;
    background: var(--surface-secondary);
    border: 1px solid var(--border);
    white-space: nowrap;
}

.dropdown-content a:hover {
    background: var(--accent-soft);
    color: var(--accent);
}

.dropdown-content a.active {
    background: var(--accent);
    color: white;
    border-color: var(--accent);
}

/* ===== 头部样式 ===== */
.header {
    background: var(--header-bg); 
    color: white; 
    border-radius: 0 0 40px 40px;
    padding: 24px 0 32px; 
    box-shadow: var(--card-shadow); 
    margin-bottom: 30px;
}

.header-row {
    display: flex; 
    align-items: center; 
    justify-content: space-between;
    flex-wrap: wrap; 
    gap: 20px;
}

.logo-area { 
    display: flex; 
    align-items: center; 
    gap: 16px; 
}

.logo-area img { 
    height: 56px; 
    width: auto; 
}

.site-title {
    font-size: 1.5rem; 
    font-weight: 700; 
    background: rgba(255,255,255,0.1);
    padding: 8px 24px; 
    border-radius: 60px; 
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.2);
    color: white;
    text-decoration: none;
}

.header-center {
    flex: 1; 
    text-align: center; 
    font-weight: 500; 
    font-size: 1.5rem;
    background: rgba(0,0,0,0.1); 
    padding: 8px 24px; 
    border-radius: 60px;
    backdrop-filter: blur(8px); 
    border: 1px solid rgba(255,255,255,0.15);
}

.header-right { 
    display: flex; 
    gap: 12px; 
    align-items: center; 
}

/* ===== 自定义语言切换 ===== */
.custom-select {
    position: relative;
    background: rgba(255,255,255,0.15);
    border: 1px solid rgba(255,255,255,0.3);
    border-radius: 40px;
    padding: 6px 16px;
    color: white;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 8px;
    backdrop-filter: blur(8px);
    cursor: pointer;
    min-width: 100px;
}

.custom-select:hover {
    background: rgba(255,255,255,0.25);
    border-color: rgba(255,255,255,0.5);
}

.select-selected {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.select-selected::after {
    content: "▼";
    font-size: 0.7rem;
    margin-left: 8px;
    opacity: 0.8;
    transition: transform 0.2s;
}

.custom-select.active .select-selected::after {
    transform: rotate(180deg);
}

.select-items {
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    margin-top: 5px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: var(--card-shadow);
    z-index: 1000;
    display: none;
}

.custom-select.active .select-items {
    display: block;
}

.select-items div {
    padding: 10px 16px;
    color: var(--text-primary);
    cursor: pointer;
    transition: all 0.2s;
    text-align: center;
}

.select-items div:hover {
    background: var(--accent-soft);
    color: var(--accent);
}

.select-items div.selected {
    background: var(--accent);
    color: white;
}

/* ===== 主题切换按钮 ===== */
.theme-toggle {
    background: rgba(255,255,255,0.15); 
    border: 1px solid rgba(255,255,255,0.3);
    border-radius: 40px; 
    padding: 8px 20px; 
    font-size: 0.95rem; 
    color: white;
    cursor: pointer; 
    display: flex; 
    align-items: center; 
    gap: 8px; 
    backdrop-filter: blur(8px);
    transition: all 0.2s;
}

.theme-toggle:hover {
    background: rgba(255,255,255,0.25);
    border-color: rgba(255,255,255,0.5);
}

/* ===== 文档卡片 ===== */
.doc-card {
    background-color: var(--surface); 
    border-radius: 40px;
    padding: 3rem; 
    box-shadow: var(--card-shadow);
    border: 1px solid var(--border); 
    margin: 20px 0 40px;
}

h1 {
    font-size: 2.5rem; 
    font-weight: 700; 
    letter-spacing: -0.02em;
    background: linear-gradient(135deg, var(--accent), var(--accent-light));
    -webkit-background-clip: text;
    margin: 0 0 25px 0;
}

h2 {
    font-size: 2rem; 
    font-weight: 600; 
    margin: 2.5rem 0 1.5rem;
    color: var(--text-primary); 
    border-bottom: 3px solid var(--accent-soft);
    padding-bottom: 12px;
}

h3 {
    font-size: 1.5rem; 
    font-weight: 600; 
    margin: 2rem 0 1rem;
    color: var(--accent);
}

/* ===== 基准测试表格 ===== */
.benchmark-container {
    overflow-x: auto;
    margin: 30px 0;
    border-radius: 24px;
    border: 1px solid var(--border);
    background: var(--surface);
    box-shadow: var(--card-shadow);
}

.benchmark-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    min-width: 1000px;
}

.benchmark-table th {
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 700;
    padding: 16px 12px;
    text-align: center;
    border-bottom: 2px solid var(--border);
}

.benchmark-table td {
    padding: 12px 10px;
    border-bottom: 1px solid var(--border);
    vertical-align: middle;
}

.benchmark-table tr:last-child td {
    border-bottom: none;
}

.benchmark-table tr:hover td {
    background: var(--accent-soft);
}

.traffic-cell {
    font-weight: 600;
    color: var(--text-primary);
    background: var(--surface-secondary);
}

.param-cell {
    text-align: center;
}

.warning-cell {
    background: rgba(245, 158, 11, 0.1);
    color: var(--warning);
    font-style: italic;
}

/* ===== 星标建议 ===== */
.advice-item {
    display: flex;
    gap: 15px;
    margin: 20px 0;
    padding: 20px;
    background: var(--surface-secondary);
    border-radius: 20px;
    border: 1px solid var(--border);
}

.stars {
    display: flex;
    gap: 2px;
    color: var(--star-color);
    font-size: 1.2rem;
    min-width: 60px;
}

.advice-item a {
    color: var(--accent);
}

.advice-item a:hover {
    color: var(--accent-light);
}

/* ===== 信息卡片 ===== */
.info-card {
    background: var(--accent-soft);
    border-radius: 20px;
    padding: 20px;
    margin: 20px 0;
    border-left: 6px solid var(--accent);
}

.info-card a {
    color: var(--accent);
}

.info-card a:hover {
    color: var(--accent-light);
}

/* ===== 注意框 ===== */
.note-box {
    background: var(--surface-secondary);
    padding: 15px 20px;
    border-radius: 16px;
    border-left: 4px solid var(--warning);
    margin: 20px 0;
    font-size: 0.9rem;
}

.note-box a {
    color: var(--accent);
}

.note-box a:hover {
    color: var(--accent-light);
}

/* ===== 返回顶部按钮 ===== */
.back-to-top {
    position: fixed;
    bottom: 30px;
    right: 30px;
    background: var(--accent);
    color: white;
    width: 56px;
    height: 56px;
    border-radius: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border: none;
    box-shadow: 0 10px 25px rgba(79, 70, 229, 0.3);
    transition: all 0.2s;
    z-index: 99;
    font-size: 1.2rem;
}

.back-to-top:hover {
    transform: scale(1.1);
    background: var(--accent-light);
}

/* ===== 页脚 ===== */
.footer {
    background-color: var(--footer-bg); 
    margin-top: 60px;
    padding: 32px 24px; 
    border-radius: 40px 40px 0 0;
    border-top: 1px solid var(--border); 
    color: var(--text-secondary);
}

.footer-content {
    display: flex; 
    flex-wrap: wrap; 
    justify-content: space-between;
    align-items: center; 
    gap: 20px; 
    max-width: 1300px; 
    margin: 0 auto;
}

.footer-copyright {
    background: var(--surface); 
    padding: 8px 24px; 
    border-radius: 60px;
    border: 1px solid var(--border); 
    font-size: 0.95rem;
}

.footer-license {
    display: flex;
    align-items: center;
    gap: 10px;
}

.footer-license img {
    width: 24px;
    height: 24px;
    vertical-align: middle;
}

/* ===== 移动端响应式调整 ===== */
@media (max-width: 700px) {
    .header-row { 
        flex-direction: column; 
        text-align: center;
    }
    
    .header-center {
        width: 100%;
    }
    
    .header-right {
        width: 100%;
        justify-content: center;
    }
    
    .doc-card { 
        padding: 1.8rem; 
    }
    
    h1 { 
        font-size: 2rem; 
    }
    
    .back-to-top {
        bottom: 20px;
        right: 20px;
        width: 48px;
        height: 48px;
        border-radius: 24px;
        font-size: 1rem;
        opacity: 0.9;
    }
    
    .footer {
        padding: 24px 16px;
    }
    
    .footer-content {
        flex-direction: column;
        text-align: center;
        gap: 15px;
    }
    
    .footer-copyright {
        width: 100%;
        text-align: center;
    }
    
    .footer-license {
        justify-content: center;
    }
}
</style>
</head>
<body>
    <!-- 导航栏 - 悬浮下拉式 -->
    <div class="nav-bar">
        <div class="container nav-container">
            <div class="nav-header">
              <span class="home-icon">🏠</span>
                <div class="nav-left">
                    <a href="index.html" class="nav-home">
                        
                        <span class="home-text" data-i18n="navHome">AWStats 文档</span>
                    </a>
                </div>
                <div class="breadcrumb">
                    <a href="index.html" data-i18n="home">主页</a>
                    <span>›</span>
                    <span data-i18n="currentPage">基准测试</span>
                </div>
                <div class="mobile-menu-toggle" id="mobileMenuToggle">
                    ☰
                </div>
            </div>
            
            <!-- 悬浮下拉菜单 -->
            <div class="dropdown-menu" id="mobileMenu">
                <!-- 📌 基础文档 -->
                <div class="dropdown-item">
                    <div class="dropdown-title" data-i18n="categoryBasic">📌 基础文档</div>
